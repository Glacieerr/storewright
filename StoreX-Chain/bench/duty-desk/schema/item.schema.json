{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Duty-Desk Bench item",
  "description": "One question of the benchmark. Items with the same pair are asked in order in one conversation; every other item starts a new conversation. role is the asker's role (it sets what may be approved).",
  "type": "object",
  "required": [
    "set",
    "id",
    "question",
    "role",
    "expect"
  ],
  "additionalProperties": false,
  "properties": {
    "set": {
      "enum": [
        "blind1",
        "blind2",
        "blind3",
        "blind4"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[BCDE][0-9]{2}$"
    },
    "question": {
      "type": "string"
    },
    "role": {
      "enum": [
        "viewer",
        "dispatcher",
        "manager",
        "regional"
      ]
    },
    "pair": {
      "type": "string",
      "description": "Conversation id for multi-turn items."
    },
    "expect": {
      "type": "object",
      "required": [
        "intent",
        "tools",
        "behavior"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "enum": [
            "overview",
            "risks",
            "vehicle",
            "late",
            "stock",
            "doors",
            "port",
            "airport",
            "dc",
            "store",
            "cards",
            "approve",
            "reject",
            "explain",
            "whatif",
            "handover",
            "kpi",
            "incidents",
            "schedule",
            "forecast",
            "network",
            "crossborder",
            "optimize",
            "review",
            "knowledge",
            "help",
            "rootcause",
            "anomaly",
            "hub",
            "cargo",
            "bottleneck",
            "appointments",
            "dailyplan",
            "quality",
            "policy",
            "decline"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "get_overview",
              "list_risks",
              "get_vehicle",
              "list_late",
              "get_stock",
              "get_doors",
              "get_facility",
              "list_cards",
              "explain_card",
              "what_if",
              "propose_decision",
              "get_kpi",
              "list_incidents",
              "get_schedule",
              "shift_handover",
              "review_recommendations",
              "get_forecast",
              "plan_network",
              "get_crossborder",
              "optimize_dispatch",
              "search_knowledge",
              "help",
              "explain_delay",
              "detect_anomalies",
              "get_hub",
              "trace_own_cargo",
              "hub_bottlenecks",
              "plan_appointments",
              "daily_plan",
              "get_data_quality",
              "get_policy",
              "clarify"
            ]
          },
          "description": "The first tool is the main one. For clarify/decline/refuse items the tools are only a hint (the tool score then means: nothing executed, no non-read tool called)."
        },
        "behavior": {
          "enum": [
            "answer",
            "clarify",
            "decline",
            "refuse",
            "proposal"
          ]
        }
      }
    },
    "accept": {
      "type": "object",
      "description": "Alternatives the item author marked as also acceptable, kept only when their condition holds in the evaluation data.",
      "properties": {
        "behaviors": {
          "type": "array",
          "items": {
            "enum": [
              "answer",
              "clarify",
              "decline",
              "refuse",
              "proposal"
            ]
          }
        },
        "withTool": {
          "type": "string"
        },
        "allowDecide": {
          "type": "boolean"
        },
        "altIntents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "altTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "textHas": {
          "type": "string",
          "description": "Regular expression the answer text must match for altTools to count."
        },
        "escalated": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "either": {
      "const": true,
      "description": "Refusing or an escalated proposal are both correct (author's note)."
    },
    "note": {
      "type": "string",
      "description": "The item author's note (English)."
    }
  }
}
