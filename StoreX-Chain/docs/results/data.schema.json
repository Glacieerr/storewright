{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoreX Chain results (docs/results/data.json)",
  "description": "Machine-readable results of StoreX Chain, generated by `npm run reports` (src/cli/write.ts) together with web/src/data/results.json. Do not edit data.json by hand. Field meanings and units: DATA.md. All numbers come from simulations with synthetic data; this project is not affiliated with any retailer or company.",
  "type": "object",
  "required": ["seeds", "kpis", "gens", "costCats", "pairs", "levers", "sweeps", "capacity", "stress", "automation", "economics", "stores", "flows", "twin", "runtime", "runs"],
  "additionalProperties": false,
  "properties": {
    "seeds": {
      "description": "Number of seeds per experiment family.",
      "type": "object",
      "required": ["compare", "sweep"],
      "additionalProperties": false,
      "properties": {
        "compare": { "description": "Seeds in the generation comparison (gens, pairs).", "type": "integer", "minimum": 1 },
        "sweep": { "description": "Seeds per configuration in sweeps, capacity and stress.", "type": "integer", "minimum": 1 }
      }
    },
    "kpis": {
      "description": "The KPI dictionary; its keys are the keys of every `mean` object.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "unit", "group", "better", "digits"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "#/$defs/kpiKey" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "group": { "type": "string" },
          "better": { "enum": ["higher", "lower", "none"] },
          "digits": { "description": "Decimals used for display.", "type": "integer", "minimum": 0 }
        }
      }
    },
    "gens": {
      "description": "The three generations, averaged over seeds.compare seeds.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["gen", "label", "mean", "ci", "cost"],
        "additionalProperties": false,
        "properties": {
          "gen": { "$ref": "#/$defs/genKey" },
          "label": { "type": "string" },
          "mean": { "$ref": "#/$defs/kpiValues" },
          "ci": { "description": "Half-width of the 95% confidence interval of each mean.", "$ref": "#/$defs/kpiValues" },
          "cost": { "description": "USD per day by category, in the order of costCats.", "type": "array", "items": { "$ref": "#/$defs/num" } }
        }
      }
    },
    "costCats": {
      "description": "Labels of the cost categories, in the order of gens[].cost.",
      "type": "array",
      "items": { "type": "string" }
    },
    "pairs": {
      "description": "Paired comparisons of g3 against g1 (g3g1) and against g2 (g3g2), one row per KPI.",
      "type": "object",
      "required": ["g3g1", "g3g2"],
      "additionalProperties": false,
      "properties": {
        "g3g1": { "type": "array", "items": { "$ref": "#/$defs/pairRow" } },
        "g3g2": { "type": "array", "items": { "$ref": "#/$defs/pairRow" } }
      }
    },
    "levers": {
      "description": "What each lever is worth on its own (chosen value minus baseline, other levers at the g3 choice).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "from", "to", "cost", "co2", "service", "inventory"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "cost": { "description": "Change in costTotal, USD per day.", "$ref": "#/$defs/num" },
          "co2": { "description": "Change in co2Local, t CO2 per day.", "$ref": "#/$defs/num" },
          "service": { "description": "Change in service, percentage points.", "$ref": "#/$defs/num" },
          "inventory": { "description": "Change in workingCapital, million USD.", "$ref": "#/$defs/num" }
        }
      }
    },
    "sweeps": {
      "description": "Decision sweeps: one lever varied, the others at the g3 choice.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "question", "chart", "chosen", "kpis", "points"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "question": { "type": "string" },
          "chart": { "description": "KPI key drawn in the chart.", "$ref": "#/$defs/kpiKey" },
          "chosen": { "description": "Value chosen for g3.", "$ref": "#/$defs/leverValue" },
          "kpis": { "type": "array", "items": { "$ref": "#/$defs/kpiKey" } },
          "note": { "description": "Optional remark shown with the sweep (a caveat about how to read it).", "type": "string" },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["value", "label", "mean"],
              "additionalProperties": false,
              "properties": {
                "value": { "$ref": "#/$defs/leverValue" },
                "label": { "type": "string" },
                "mean": { "$ref": "#/$defs/kpiValues" }
              }
            }
          }
        }
      }
    },
    "capacity": {
      "description": "Demand growth: every KPI at several demand scales for each generation.",
      "type": "object",
      "required": ["scales", "gens"],
      "additionalProperties": false,
      "properties": {
        "scales": { "description": "Demand multipliers (1 = today's demand).", "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "gens": {
          "type": "object",
          "required": ["g1", "g2", "g3"],
          "additionalProperties": false,
          "properties": {
            "g1": { "type": "array", "items": { "$ref": "#/$defs/kpiValues" } },
            "g2": { "type": "array", "items": { "$ref": "#/$defs/kpiValues" } },
            "g3": { "type": "array", "items": { "$ref": "#/$defs/kpiValues" } }
          }
        }
      }
    },
    "stress": {
      "description": "Stress drills, compared seed by seed with the same run without the disruption.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "detail", "gens"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "gens": {
            "type": "object",
            "required": ["g1", "g2", "g3"],
            "additionalProperties": false,
            "properties": {
              "g1": { "$ref": "#/$defs/stressMetrics" },
              "g2": { "$ref": "#/$defs/stressMetrics" },
              "g3": { "$ref": "#/$defs/stressMetrics" }
            }
          }
        }
      }
    },
    "automation": {
      "description": "Business case of DC automation in three cases.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "npv", "irr", "payback", "withoutNpv", "hours"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "npv": { "description": "Incremental NPV, USD.", "$ref": "#/$defs/num" },
          "irr": { "description": "Incremental IRR, percent.", "$ref": "#/$defs/num" },
          "payback": { "description": "Incremental payback in years; null when it never pays back.", "$ref": "#/$defs/num" },
          "withoutNpv": { "description": "NPV of the upstream step without automation, USD.", "$ref": "#/$defs/num" },
          "hours": { "description": "DC labour hours saved per day.", "$ref": "#/$defs/num" }
        }
      }
    },
    "economics": {
      "type": "object",
      "required": ["upstream", "system", "sensitivity"],
      "additionalProperties": false,
      "properties": {
        "upstream": { "$ref": "#/$defs/econ" },
        "system": { "$ref": "#/$defs/econ" },
        "sensitivity": {
          "description": "Upstream NPV (USD) with each assumption at its low and high value.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "low", "high"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "low": { "$ref": "#/$defs/labelledNpv" },
              "high": { "$ref": "#/$defs/labelledNpv" }
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "size", "docks"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "size": { "description": "Sales relative to the part 2 StoreX store.", "type": "number", "exclusiveMinimum": 0 },
          "docks": { "description": "Receiving docks.", "type": "integer", "minimum": 1 }
        }
      }
    },
    "flows": {
      "description": "Flow plan of the long-haul product families (g3, seed 1).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "via", "palletsPerDay", "loads", "interval", "costDc", "costDirect", "reason"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "via": { "enum": ["direct", "dc"] },
          "palletsPerDay": { "$ref": "#/$defs/num" },
          "loads": { "description": "Full truckloads per order when delivered direct.", "$ref": "#/$defs/num" },
          "interval": { "description": "Average days between direct deliveries.", "$ref": "#/$defs/num" },
          "costDc": { "description": "USD per day through the DC.", "$ref": "#/$defs/num" },
          "costDirect": { "description": "USD per day delivered direct.", "$ref": "#/$defs/num" },
          "reason": { "type": "string" }
        }
      }
    },
    "twin": {
      "description": "Closed-loop twin study.",
      "type": "object",
      "required": ["seeds", "arms", "levels"],
      "additionalProperties": false,
      "properties": {
        "seeds": { "type": "integer", "minimum": 1 },
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "short"],
            "additionalProperties": false,
            "properties": {
              "key": { "description": "open, safe, dispatcher, auto.", "type": "string" },
              "label": { "type": "string" },
              "short": { "type": "string" }
            }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "arms", "fidelity"],
            "additionalProperties": false,
            "properties": {
              "key": { "description": "normal or rough.", "type": "string" },
              "label": { "type": "string" },
              "arms": { "type": "object", "additionalProperties": { "$ref": "#/$defs/twinArmResult" } },
              "fidelity": {
                "type": "object",
                "required": ["eta30", "eta60", "eta120", "temp"],
                "additionalProperties": false,
                "properties": {
                  "eta30": { "description": "Mean ETA error (minutes) of predictions 15-45 minutes ahead.", "$ref": "#/$defs/num" },
                  "eta60": { "description": "Mean ETA error (minutes) of predictions 45-90 minutes ahead.", "$ref": "#/$defs/num" },
                  "eta120": { "description": "Mean ETA error (minutes) of predictions 1.5-3 hours ahead.", "$ref": "#/$defs/num" },
                  "temp": { "description": "Mean cargo-temperature estimate error, degrees C.", "$ref": "#/$defs/num" }
                }
              }
            }
          }
        }
      }
    },
    "runtime": { "description": "Seconds the npm run reports run took (changes between identical runs).", "type": "number", "minimum": 0 },
    "runs": { "description": "Number of simulation runs behind the file.", "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "num": { "description": "A number; null when it could not be computed.", "type": ["number", "null"] },
    "kpiKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "kpiValues": {
      "description": "One value per KPI key (see kpis), in that KPI's unit.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/kpiKey" },
      "additionalProperties": { "$ref": "#/$defs/num" }
    },
    "genKey": { "enum": ["g1", "g2", "g3"] },
    "leverValue": { "type": ["number", "string", "boolean"] },
    "pairRow": {
      "type": "object",
      "required": ["key", "pct", "verdict"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/kpiKey" },
        "pct": { "description": "Change of g3 relative to the other generation, percent.", "$ref": "#/$defs/num" },
        "verdict": { "enum": ["改善", "变差", "无显著差异", "—"] }
      }
    },
    "stressMetrics": {
      "type": "object",
      "required": ["window", "windowDrop", "worstDrop", "airDrop", "onTimeDrop", "response", "extraCost", "lostUnits"],
      "additionalProperties": false,
      "properties": {
        "window": { "description": "Mean service level over the 3 weeks after the start, percent.", "$ref": "#/$defs/num" },
        "windowDrop": { "description": "Drop of that mean against no disruption, percentage points.", "$ref": "#/$defs/num" },
        "worstDrop": { "description": "Largest one-day service drop, percentage points.", "$ref": "#/$defs/num" },
        "airDrop": { "description": "Largest one-day drop in air-freight fresh service in the first week, percentage points.", "$ref": "#/$defs/num" },
        "onTimeDrop": { "description": "Largest one-day drop in on-time delivery in the first 3 days, percentage points.", "$ref": "#/$defs/num" },
        "response": { "description": "Cost of the response measures, USD.", "$ref": "#/$defs/num" },
        "extraCost": { "description": "Extra supply-chain cost over the run, response included, USD.", "$ref": "#/$defs/num" },
        "lostUnits": { "description": "Extra lost sales over the 3 weeks, units.", "$ref": "#/$defs/num" }
      }
    },
    "econ": {
      "type": "object",
      "required": ["capex", "npv", "irr", "payback", "workingCapital", "steady", "rows", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "capex": { "description": "Total investment, USD.", "$ref": "#/$defs/num" },
        "npv": { "description": "10-year NPV at the base discount rate, USD.", "$ref": "#/$defs/num" },
        "irr": { "description": "Internal rate of return, percent.", "$ref": "#/$defs/num" },
        "payback": { "description": "Payback period, years.", "$ref": "#/$defs/num" },
        "workingCapital": { "description": "Working capital released by lower inventory, USD.", "$ref": "#/$defs/num" },
        "steady": {
          "description": "Steady-state savings and costs, USD per year.",
          "type": "object",
          "required": ["gross", "opex", "net"],
          "additionalProperties": false,
          "properties": {
            "gross": { "$ref": "#/$defs/num" },
            "opex": { "$ref": "#/$defs/num" },
            "net": { "$ref": "#/$defs/num" }
          }
        },
        "rows": {
          "description": "Cash flow per year, USD.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year", "gross", "opex", "capex", "wc", "net", "cumulative"],
            "additionalProperties": false,
            "properties": {
              "year": { "type": "integer" },
              "gross": { "$ref": "#/$defs/num" },
              "opex": { "$ref": "#/$defs/num" },
              "capex": { "$ref": "#/$defs/num" },
              "wc": { "description": "Working capital released.", "$ref": "#/$defs/num" },
              "net": { "$ref": "#/$defs/num" },
              "cumulative": { "$ref": "#/$defs/num" }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "detail", "npv", "irr", "payback", "cumulative"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "detail": { "type": "string" },
              "npv": { "$ref": "#/$defs/num" },
              "irr": { "$ref": "#/$defs/num" },
              "payback": { "$ref": "#/$defs/num" },
              "cumulative": { "description": "Cumulative cash flow per year, USD.", "type": "array", "items": { "$ref": "#/$defs/num" } }
            }
          }
        }
      }
    },
    "labelledNpv": {
      "type": "object",
      "required": ["label", "npv"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "npv": { "$ref": "#/$defs/num" }
      }
    },
    "twinArmResult": {
      "description": "Per-day outcome of one policy at one field level.",
      "type": "object",
      "required": ["late", "hot", "short", "lost", "cost", "cards", "auto", "user", "expired"],
      "additionalProperties": false,
      "properties": {
        "late": { "description": "Late store receiving, minutes.", "$ref": "#/$defs/num" },
        "hot": { "description": "Cold-chain over-temperature, minutes.", "$ref": "#/$defs/num" },
        "short": { "description": "Store stock-out, minutes.", "$ref": "#/$defs/num" },
        "lost": { "description": "Lost sales, units.", "$ref": "#/$defs/num" },
        "cost": { "description": "Cost of the twin's actions, USD.", "$ref": "#/$defs/num" },
        "cards": { "description": "Recommendation cards raised.", "$ref": "#/$defs/num" },
        "auto": { "description": "Cards executed automatically.", "$ref": "#/$defs/num" },
        "user": { "description": "Cards approved by the dispatcher.", "$ref": "#/$defs/num" },
        "expired": { "description": "Cards nobody handled where the problem then happened.", "$ref": "#/$defs/num" }
      }
    }
  }
}
